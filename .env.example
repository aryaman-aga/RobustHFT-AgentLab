# Copy to .env (git-ignored) and fill in. Only needed for agent.mode=llm;
# the default mock mode runs fully offline without any key.
# config.py reads these variables; YAML configs can never carry keys.

# mock | anthropic | openai | ollama   (openai = any OpenAI-compatible endpoint)
RHAL_LLM_PROVIDER=mock

# Model id for the chosen provider (defaults to LLMCfg.model in src/rhal/config.py)
# RHAL_LLM_MODEL=

# provider=ollama: a local server installed INSIDE .venv (make llm-setup llm-up llm-pull); no key needed.
# Only loopback hosts are accepted. Model tags as pulled, e.g. qwen2.5:7b or llama3.2:3b.
# RHAL_LLM_MODEL=qwen2.5:7b
# OLLAMA_HOST=127.0.0.1:11434

# provider=anthropic
# ANTHROPIC_API_KEY=

# provider=openai (set OPENAI_BASE_URL for a local server, e.g. Ollama/vLLM)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Responses are cached here, keyed by prompt hash, so re-runs are free and reproducible
# RHAL_LLM_CACHE_DIR=outputs/llm_cache
