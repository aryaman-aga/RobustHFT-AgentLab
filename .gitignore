# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.coverage
htmlcov/

# --- Secrets: API keys live only in .env (template: .env.example) ----------
.env

# --- Run artifacts: regenerate with `make all` -----------------------------
# Results that the paper needs are copied into paper/tables and paper/figures
# by scripts/make_report_tables.py, so outputs/ itself is never committed.
outputs/*
!outputs/.gitkeep

# Sample CSVs are generated by `make data` (scripts/generate_sample_data.py)
data/sample/
data/real/

# --- LaTeX build products (compile with `make paper`) ----------------------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
paper/*.pdf
paper/aaai/*.pdf
paper/aaai/build/
paper/aaai/*.zip

# --- Editors / OS ------------------------------------------------------------
.DS_Store
.vscode/
.idea/

# --- Local scratch and Claude Code files (session worktrees, preview config) --
scratch/
.claude/
